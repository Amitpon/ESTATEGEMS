# Appwrite - אופציונלי. בלי הערכים האלה, ה-UI של Auth/שמירה בענן פשוט לא מוצג
# (isAppwriteConfigured() מחזיר false) - הכלי ממשיך לעבוד מקומית כרגיל.
#
# איך משיגים:
# 1. https://cloud.appwrite.io -> Create Project
# 2. Settings -> Platforms -> Add Platform -> Web App -> לרשום localhost ואת דומיין נטליפיי
# 3. Databases -> Create Database (main) -> Create Collection (properties)
#    עם attributes: label (string), input (string, גדול - JSON מלא של PropertyInput)
#    ו-Document Security מופעל, כדי ש-$permissions ברמת מסמך יעבדו
# 4. Project ID נמצא ב-Settings הראשי של הפרויקט
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=main
VITE_APPWRITE_PROPERTIES_COLLECTION_ID=properties
